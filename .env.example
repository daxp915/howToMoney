# Copy to .env, then run `npm run setup` to generate the random secrets.
# Nothing in .env is ever printed to the console by the project's scripts.

# ---- Database ----
POSTGRES_USER=howtomoney
# Generated by `npm run setup` if left blank.
POSTGRES_PASSWORD=
POSTGRES_DB=howtomoney
# Rewritten by `npm run setup` to match POSTGRES_PASSWORD.
# Host is `db` inside Docker, `localhost` when running npm scripts on the host.
DATABASE_URL=

# ---- SimpleFIN ----
# Paste the one-time setup token from the SimpleFIN Bridge UI here, then run
# `npm run simplefin:claim`. The script exchanges it for a long-lived access
# URL, writes that into SIMPLEFIN_ACCESS_URL below, and blanks this line.
# A setup token can only be claimed ONCE.
SIMPLEFIN_SETUP_TOKEN=

# Filled in automatically by the claim step. Read-only credentials for your
# full transaction history -- treat it like a password.
SIMPLEFIN_ACCESS_URL=

# ---- Plaid (optional; without both keys the app offers SimpleFIN only) ----
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# Public https address of /api/plaid/webhook. Plaid then says when a bank has
# new transactions instead of waiting for the schedule. The path must be
# reachable past Cloudflare Access (a Bypass policy for that path only; the
# request authenticates itself with Plaid's signature). After setting it,
# `npm run plaid:webhook` points banks linked earlier at it.
# PLAID_WEBHOOK_URL=

# ---- Claude ----
ANTHROPIC_API_KEY=
AI_PROVIDER=claude          # claude | ollama | none
AI_MODEL=claude-opus-5
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# The Advisor. It sends the model aggregates only (totals, categories, cleaned
# merchant names), never transactions. ADVISOR_FLOOR is the cash the
# affordability check keeps in reserve unless a question names another.
# ADVISOR_MODEL=claude-opus-5
# ADVISOR_FLOOR=500
# New questions per person per month (re-runs are free until it is spent;
# admins are not limited). Unset or 0 = no limit.
# ADVISOR_MONTHLY_QUESTIONS=30

# ---- Login user ----
# Used once by `npm run db:seed` to create your account, then safe to blank out.
SEED_EMAIL=
SEED_PASSWORD=

# ---- App ----
# 32-byte base64 key for encrypting provider tokens at rest.
# Generated by `npm run setup` if left blank.
ENCRYPTION_KEY=
ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=30
SYNC_INTERVAL_MINUTES=360
TZ=America/New_York

# ---- Cloudflare Tunnel (NAS only) ----
CLOUDFLARE_TUNNEL_TOKEN=

# --- Help / feedback -------------------------------------------------------
# The Help page posts reports to a small Cloudflare Worker, which sends them on
# through Email Routing (see workers/feedback/README.md). With these unset the
# page still works and writes reports to the container log, saying plainly that
# mail is not configured.
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_SECRET=
